#!/bin/bash
# Quick Start Script for Backend Rails with LangChain

set -e

echo "=================================================="
echo "Backend Rails with LangChain - Quick Start"
echo "=================================================="
echo ""

# Check if .env exists
if [ ! -f .env ]; then
    echo "📝 Creating .env file from .env.example..."
    cp .env.example .env
    echo "✅ .env file created"
    echo ""
    echo "⚠️  IMPORTANT: Please edit .env and add your GEMINI_API_KEY"
    echo "   Get your key at: https://makersuite.google.com/app/apikey"
    echo ""
    read -p "Press Enter after you've added your API key to .env..."
else
    echo "✅ .env file already exists"
fi

echo ""
echo "🔍 Validating environment variables..."
if command -v ruby &> /dev/null; then
    if [ -f ./bin/validate-env ]; then
        ./bin/validate-env || {
            echo ""
            echo "⚠️  Environment validation failed. Please check your .env file"
            exit 1
        }
    fi
fi

echo ""
echo "🐳 Checking Docker..."
if ! command -v docker &> /dev/null; then
    echo "❌ Docker is not installed. Please install Docker first."
    exit 1
fi

if ! command -v docker-compose &> /dev/null; then
    echo "❌ Docker Compose is not installed. Please install Docker Compose first."
    exit 1
fi

echo "✅ Docker is installed"

echo ""
echo "🏗️  Building Docker images..."
docker-compose build

echo ""
echo "🚀 Starting services..."
docker-compose up -d

echo ""
echo "⏳ Waiting for database to be ready..."
sleep 5

echo ""
echo "📊 Creating database..."
docker-compose exec -T app rails db:create || echo "Database might already exist"

echo ""
echo "🔄 Running migrations..."
docker-compose exec -T app rails db:migrate

echo ""
echo "🌱 Seeding database..."
docker-compose exec -T app rails db:seed || echo "Seed might have already run"

echo ""
echo "=================================================="
echo "✅ Setup Complete!"
echo "=================================================="
echo ""
echo "🎉 Your application is running at: http://localhost:8000"
echo ""
echo "📚 Useful commands:"
echo "   make logs       - View application logs"
echo "   make console    - Open Rails console"
echo "   make shell      - Open shell in container"
echo "   make stop       - Stop all services"
echo "   make help       - Show all available commands"
echo ""
echo "📖 Documentation:"
echo "   README.md                        - Main documentation"
echo "   docs/ENVIRONMENT_VARIABLES.md    - Environment variables guide"
echo ""
echo "=================================================="
