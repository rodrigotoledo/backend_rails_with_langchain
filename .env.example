# ===================================
# Rails Configuration
# ===================================
# Environment: development, test, production
RAILS_ENV=development

# Maximum number of threads for Puma server
RAILS_MAX_THREADS=5

# ===================================
# Application Configuration
# ===================================
# Application name used for database naming
APPLICATION_NAME=langchain_searcher

# ===================================
# PostgreSQL Database Configuration
# ===================================
# Database host (use 'localhost' for local dev, 'db_postgresql' for Docker)
DB_HOST=db_postgresql

# Database port
DB_PORT=5432

# PostgreSQL superuser credentials (used by Docker container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database connection credentials (can be same as POSTGRES_*)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Optional: Full database URL (overrides individual DB settings if set)
# Format: postgresql://username:password@host:port/database_name
# DATABASE_URL=postgresql://postgres:postgres@db_postgresql:5432/langchain_searcher_development

# ===================================
# Server Configuration
# ===================================
# Port where the Rails server will listen
PORT=8000

# Binding address (0.0.0.0 for Docker, localhost for local)
BINDING=0.0.0.0

# ===================================
# Docker Development Options
# ===================================
# Force database creation on container startup (true/false)
FORCE_DB_CREATE=false

# Force database seeding on container startup (true/false)
FORCE_DB_SEED=false

# ===================================
# API Keys & External Services
# ===================================
# Google Gemini API Key for AI features
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google API Key (if different from Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key for embeddings and GPT models
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ===================================
# AI Provider Configuration
# ===================================
# Which AI provider to use for embeddings and vector search
# Supported values: 'openai' or 'gemini'
AI_PROVIDER=openai

# Embedding model to use
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Gemini: text-embedding-004, embedding-001
AI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (must match the model)
# OpenAI text-embedding-3-small: 1536
# OpenAI text-embedding-3-large: 3072
# OpenAI text-embedding-ada-002: 1536
# Gemini text-embedding-004: 768
# Gemini embedding-001: 768
AI_EMBEDDING_DIMENSIONS=1536

# ===================================
# Optional Services
# ===================================
# Redis URL (uncomment if using Redis for caching/jobs)
# REDIS_URL=redis://redis:6379/0

# Secret key base for production (generate with: rails secret)
# SECRET_KEY_BASE=

# ===================================
# Development Tools
# ===================================
# Enable Rails development features
# RAILS_DEVELOPMENT_HOSTS=.example.com

# ===================================
# Production Settings (when deploying)
# ===================================
# RAILS_SERVE_STATIC_FILES=true
# RAILS_LOG_TO_STDOUT=true
# WEB_CONCURRENCY=2
